# Porta onde o servidor vai rodar
PORT=3000

# Endereço do banco PostgreSQL
# Local:    postgresql://postgres:SENHA@localhost:5433/mcdevs_burger
# Supabase: pegue em Connect > ORM > Prisma (use a URL do session pooler, porta 5432)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:PORTA/BANCO"

# Endereço do front (para o CORS)
FRONTEND_URL=http://localhost:5173